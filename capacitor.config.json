{
  "appId": "com.rizjr.projectfitness",
  "appName": "Project Fitness",
  "webDir": "www",
  "backgroundColor": "#000000",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#000000",
    "limitsNavigationsToAppBoundDomains": false,
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "plugins": {
    "LocalNotifications": {
      "presentationOptions": [
        "banner",
        "sound",
        "list"
      ]
    }
  },
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  }
}
